# Copy to .env for local use. Never commit the real salt.
# The grader injects it at startup: DAY1_SALT=<salt> docker compose up -d --build

# Per-team HMAC salt (printed on the team slip). Read from the environment only.
DAY1_SALT=

# Infrastructure (local development defaults; change for anything non-local)
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon
POSTGRES_DB=nascon
RABBITMQ_USER=nascon
RABBITMQ_PASSWORD=nascon
MINIO_ROOT_USER=nascon
MINIO_ROOT_PASSWORD=nascon-secret
# JWT signing secret for /api/v1 and RBAC tokens (any long random string)
JWT_SECRET=nascon-local-jwt-secret-change-me
